# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL_NAME="groq/compound-mini"

# Mistral API Configuration
MISTRAL_API_KEY=

# Gemini API Configuration
GEMINI_API_KEY=

# PostgreSQL Database URL for Screening Log Storage (Render managed DB or local PostgreSQL)
# Example: postgresql://user:password@localhost:5432/novusai_db
# If left empty/unset, backend defaults to local SQLite file: sqlite:///./dev_screenings.db
DATABASE_URL=

# Automated Model Retraining Configuration
# Enable background scheduling job (default: false for local development)
ENABLE_AUTO_RETRAIN=false
# Number of new confirmed screening records required to trigger automatic retraining (default: 1000)
RETRAIN_THRESHOLD=1000
